# ---- Core ----
APP_ENV=development
PORT=8080
# Postgres is published on 5433 by docker-compose (5432 may be taken by another local DB).
DATABASE_URL=postgres://candella:candella@localhost:5433/candella?sslmode=disable
# The API switches every connection into the restricted candella_app role, and
# the platform console into candella_platform (migration 0025), so neither can
# bypass row-level security. A production login that is not the migration
# login needs: GRANT candella_app TO <login>; (and candella_platform for the
# console's login).
# Optional: a separate login for the platform console. Defaults to DATABASE_URL.
PLATFORM_DATABASE_URL=
REDIS_URL=redis://localhost:6381
ALLOWED_CORS_ORIGIN=http://localhost:3000
# Public origin of the frontend (used for reset links and OAuth redirects back).
APP_BASE_URL=http://localhost:3000

# Reverse proxies / load balancers in front of the API, as comma-separated IPs
# or CIDRs (e.g. 10.0.0.0/8). X-Forwarded-For is trusted only from these.
# Leave blank when clients connect directly (local dev). If the API runs behind
# a proxy and this is blank, every user shares the proxy's rate-limit bucket.
TRUSTED_PROXIES=

# ---- Sessions / cookies ----
SESSION_COOKIE_NAME=candella_session
SESSION_TTL_HOURS=720
# Set to true in production (HTTPS). Kept false for local http dev.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# ---- Password hashing (Argon2id) ----
ARGON2_MEMORY_KB=65536
ARGON2_TIME=3
ARGON2_THREADS=2

# ---- Two-factor auth ----
# 32-byte key, base64-encoded — AES-256-GCM key that encrypts TOTP secrets at rest.
# Generate: `openssl rand -base64 32`. Required to enable 2FA.
TOTP_ENCRYPTION_KEY=

# ---- One-time codes / tokens ----
EMAIL_CODE_TTL_MINUTES=10
RESET_TOKEN_TTL_MINUTES=30

# 32-byte key, base64-encoded — signs the stateless challenges issued during
# sign-in (the 2FA hand-off token and the OAuth state parameter).
# Generate: `openssl rand -base64 32`.
# Must be identical on every instance and stable across restarts, otherwise
# sign-ins already in flight fail. Required in production; a random per-process
# key is used in development if left blank.
CHALLENGE_SIGNING_KEY=

# ---- Email delivery ----
# "console" prints codes/links to the server log (dev only).
# For production, verify a sending domain in Resend and set MAILER=resend,
# RESEND_API_KEY, EMAIL_FROM on that domain, and a public HTTPS APP_BASE_URL.
# See pkg/mailer/README.md. MAILER=resend without a key fails at startup.
MAILER=console
RESEND_API_KEY=
EMAIL_FROM=Candella <noreply@candella.app>

# ---- Google OAuth (leave blank to keep the button inert) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
