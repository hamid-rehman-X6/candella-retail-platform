# ---- Core ----
APP_ENV=development
PORT=8080
# Postgres is published on 5433 by docker-compose (5432 may be taken by another local DB).
DATABASE_URL=postgres://candella:candella@localhost:5433/candella?sslmode=disable
REDIS_URL=redis://localhost:6381
ALLOWED_CORS_ORIGIN=http://localhost:3000
# Public origin of the frontend (used for reset links and OAuth redirects back).
APP_BASE_URL=http://localhost:3000

# ---- Sessions / cookies ----
SESSION_COOKIE_NAME=candella_session
SESSION_TTL_HOURS=720
# Set to true in production (HTTPS). Kept false for local http dev.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# ---- Password hashing (Argon2id) ----
ARGON2_MEMORY_KB=65536
ARGON2_TIME=3
ARGON2_THREADS=2

# ---- Two-factor auth ----
# 32-byte key, base64-encoded — AES-256-GCM key that encrypts TOTP secrets at rest.
# Generate: `openssl rand -base64 32`. Required to enable 2FA.
TOTP_ENCRYPTION_KEY=

# ---- One-time codes / tokens ----
EMAIL_CODE_TTL_MINUTES=10
RESET_TOKEN_TTL_MINUTES=30

# ---- Email delivery ----
# "console" prints codes/links to the server log (dev). "resend" calls the Resend API.
MAILER=console
RESEND_API_KEY=
EMAIL_FROM=Candella <noreply@candella.app>

# ---- Google OAuth (leave blank to keep the button inert) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
